<UserControl x:Class="Lumen.Views.Pages.SchedulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Lumen.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,64,36,28" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="Расписание" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Свет включается и выключается сам — пока Lumen запущен (можно свернуть в трей)"
                       Style="{StaticResource Label}" Margin="0,6,0,24"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== Правила ===== -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Top" v:Motion.Entrance="0">
                    <StackPanel>
                        <TextBlock Text="Правила" Style="{StaticResource H1}"/>
                        <ItemsControl ItemsSource="{Binding ScheduleItems}" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0CFFFFFF" CornerRadius="14" Padding="16,12" Margin="0,0,0,10"
                                            BorderBrush="#12FFFFFF" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource DisplayFont}" FontSize="26"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="78"/>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ActionText}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock FontSize="12.5" Foreground="{StaticResource Text2}" Margin="0,3,0,0">
                                                    <Run Text="{Binding DaysText, Mode=OneWay}"/>
                                                    <Run Text="{Binding DetailText, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}"/>
                                            <Button Grid.Column="3" Style="{StaticResource GhostIcon}" v:Ui.Glyph="&#xE74D;" Margin="10,0,-4,0"
                                                    ToolTip="Удалить правило"
                                                    Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Visibility="{Binding HasSchedule, Converter={StaticResource BoolVisInv}}" Margin="0,6,0,4">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" FontSize="34" Foreground="{StaticResource Text3}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Правил пока нет" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0"
                                       Text="Например: в 19:00 — тёплый свет на 40 %, в 23:30 — выключить всё."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Новое правило ===== -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" v:Motion.Entrance="1"
                        DataContext="{Binding NewRule}">
                    <StackPanel>
                        <TextBlock Text="Новое правило" Style="{StaticResource H1}"/>

                        <TextBlock Text="Время" Style="{StaticResource Label}" FontSize="13" Margin="0,18,0,8"/>
                        <TextBox Style="{StaticResource Input}" Width="120" HorizontalAlignment="Left" FontSize="18"
                                 Tag="07:30" Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Дни" Style="{StaticResource Label}" FontSize="13" Margin="0,18,0,8"/>
                        <ItemsControl ItemsSource="{Binding Days}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource DayChip}" Content="{Binding Label}" IsChecked="{Binding IsOn}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Действие" Style="{StaticResource Label}" FontSize="13" Margin="0,18,0,8"/>
                        <ListBox ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}"
                                 ItemContainerStyle="{StaticResource ChoiceItem}" Background="Transparent" BorderThickness="0" Padding="0">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ItemsPresenter/>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" Margin="0,0,6,0" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Для «Включить свет»: заодно задать яркость и температуру -->
                        <StackPanel Visibility="{Binding IsMainOn, Converter={StaticResource BoolVis}}" Margin="0,10,0,0"
                                    v:Motion.FadeInOnVisible="True">
                            <CheckBox Style="{StaticResource Switch}" Content="Задать яркость и температуру" IsChecked="{Binding SetLight}"/>
                            <StackPanel Visibility="{Binding SetLight, Converter={StaticResource BoolVis}}">
                                <Grid Style="{StaticResource RowGrid}" Margin="0,14,0,0">
                                    <TextBlock Text="Яркость" Style="{StaticResource Label}"/>
                                    <TextBlock Style="{StaticResource Value}" Text="{Binding Brightness, StringFormat='{}{0:0} %'}"/>
                                </Grid>
                                <Slider Style="{StaticResource LSlider}" Minimum="1" Maximum="100" Value="{Binding Brightness}"/>
                                <Grid Style="{StaticResource RowGrid}" Margin="0,10,0,0">
                                    <TextBlock Text="Температура" Style="{StaticResource Label}"/>
                                    <TextBlock Style="{StaticResource Value}" Text="{Binding TemperatureText}"/>
                                </Grid>
                                <Slider Style="{StaticResource GradientSlider}" Background="{StaticResource CtTrack}"
                                        Minimum="2700" Maximum="6500" SmallChange="100" LargeChange="500" Value="{Binding Temperature}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding Error}" Foreground="#FF7A7A" FontSize="12.5" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        <Button Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" HorizontalAlignment="Left" Padding="20,12"
                                Command="{Binding DataContext.AddRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13"/>
                                <TextBlock Text="Добавить правило" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
