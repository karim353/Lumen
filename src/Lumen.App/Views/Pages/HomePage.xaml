<UserControl x:Class="Lumen.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Lumen.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="352"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Центр: сцена, свет, режимы ================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,22">
                <Grid Height="470" v:Motion.Entrance="0">
                    <v:LampScene/>
                    <!-- Синхронизация идёт -->
                    <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="26,64,0,0" Background="#33000000" ToolTip="{Binding SyncInfo}"
                            Visibility="{Binding IsSyncing, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse Fill="{StaticResource Accent}" Opacity="0" v:Motion.Pulse="{Binding IsSyncing}"/>
                                <Ellipse Fill="{StaticResource Accent}"/>
                            </Grid>
                            <TextBlock Text="LIVE" FontSize="11.5" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SyncInfo}" FontSize="11.5" Foreground="{StaticResource Text2}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="24,-44,24,0" Style="{StaticResource ControlsPanel}" IsEnabled="{Binding ControlsEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== Основной свет ===== -->
                    <Border Style="{StaticResource Card}" Margin="0" v:Motion.Entrance="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" FontSize="20" HorizontalAlignment="Center">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{Binding MainColor, Source={StaticResource Rig}}"/>
                                        </TextBlock.Foreground>
                                        <TextBlock.Effect>
                                            <DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.9"
                                                              Color="{Binding MainColor, Source={StaticResource Rig}}"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Основной свет" Style="{StaticResource H1}"/>
                                    <TextBlock Text="Освещение для работы и комфорта" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding MainPower}"/>
                            </Grid>

                            <Grid Style="{StaticResource RowGrid}" Margin="0,22,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" Foreground="{StaticResource Text2}"/>
                                    <TextBlock Text="Яркость" Style="{StaticResource Label}" Margin="12,0,0,0"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" Background="#12FFFFFF" CornerRadius="8" Padding="9,3">
                                    <TextBlock Style="{StaticResource Value}" Text="{Binding MainBright, StringFormat='{}{0:0} %'}"/>
                                </Border>
                            </Grid>
                            <Slider Style="{StaticResource LSlider}" Minimum="1" Maximum="100"
                                    SmallChange="1" LargeChange="10" Value="{Binding MainBright}"/>

                            <Grid Style="{StaticResource RowGrid}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9CA;" Foreground="{StaticResource Text2}"/>
                                    <TextBlock Text="Температура" Style="{StaticResource Label}" Margin="12,0,0,0"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Value}" Text="{Binding MainCtText}"/>
                            </Grid>
                            <Slider Style="{StaticResource GradientSlider}" Background="{StaticResource CtTrack}"
                                    Minimum="2700" Maximum="6500" SmallChange="50" LargeChange="500"
                                    Value="{Binding MainCt}"/>

                            <UniformGrid Columns="4" Margin="0,18,-8,0">
                                <Button Style="{StaticResource Choice}" Margin="0,0,8,0" Padding="4,9" Command="{Binding SetCtCommand}" CommandParameter="2700"
                                        v:Ui.Selected="{Binding CtPreset, Converter={StaticResource Is}, ConverterParameter=2700}">
                                    <StackPanel>
                                        <TextBlock Text="Тёплый" FontSize="12.5" HorizontalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                            <Ellipse Width="6" Height="6" Fill="#FFB36B" VerticalAlignment="Center"/>
                                            <TextBlock Text="2700 K" Foreground="{StaticResource Text2}" FontSize="11.5" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Choice}" Margin="0,0,8,0" Padding="4,9" Command="{Binding SetCtCommand}" CommandParameter="4000"
                                        v:Ui.Selected="{Binding CtPreset, Converter={StaticResource Is}, ConverterParameter=4000}">
                                    <StackPanel>
                                        <TextBlock Text="Нейтральный" FontSize="12.5" HorizontalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                            <Ellipse Width="6" Height="6" Fill="#FFE9D2" VerticalAlignment="Center"/>
                                            <TextBlock Text="4000 K" Foreground="{StaticResource Text2}" FontSize="11.5" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Choice}" Margin="0,0,8,0" Padding="4,9" Command="{Binding SetCtCommand}" CommandParameter="5000"
                                        v:Ui.Selected="{Binding CtPreset, Converter={StaticResource Is}, ConverterParameter=5000}">
                                    <StackPanel>
                                        <TextBlock Text="Дневной" FontSize="12.5" HorizontalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                            <Ellipse Width="6" Height="6" Fill="#FFF6EC" VerticalAlignment="Center"/>
                                            <TextBlock Text="5000 K" Foreground="{StaticResource Text2}" FontSize="11.5" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Choice}" Margin="0,0,8,0" Padding="4,9" Command="{Binding SetCtCommand}" CommandParameter="6500"
                                        v:Ui.Selected="{Binding CtPreset, Converter={StaticResource Is}, ConverterParameter=6500}">
                                    <StackPanel>
                                        <TextBlock Text="Холодный" FontSize="12.5" HorizontalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                            <Ellipse Width="6" Height="6" Fill="#D6E4FF" VerticalAlignment="Center"/>
                                            <TextBlock Text="6500 K" Foreground="{StaticResource Text2}" FontSize="11.5" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- ===== Подсветка ===== -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" v:Motion.Entrance="2">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}">
                                    <Grid Width="22" Height="22">
                                        <!-- Три пересекающихся круга — RGB, цвета берутся из подсветки -->
                                        <Ellipse Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0.95">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding BackLeft, Source={StaticResource Rig}}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="#FF3D7D" Opacity="0.8"/>
                                        <Ellipse Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.85">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding BackRight, Source={StaticResource Rig}}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Подсветка" Style="{StaticResource H1}"/>
                                    <TextBlock Text="Атмосфера и стиль" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding BgPower}"/>
                            </Grid>

                            <Grid Style="{StaticResource RowGrid}" Margin="0,22,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" Foreground="{StaticResource Text2}"/>
                                    <TextBlock Text="{Binding BgBrightLabel}" Style="{StaticResource Label}" Margin="12,0,0,0"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" Background="#12FFFFFF" CornerRadius="8" Padding="9,3">
                                    <TextBlock Style="{StaticResource Value}" Text="{Binding BgBright, StringFormat='{}{0:0} %'}"/>
                                </Border>
                            </Grid>
                            <Slider Style="{StaticResource LSlider}" Minimum="1" Maximum="100"
                                    SmallChange="1" LargeChange="10" Value="{Binding BgBright}"/>

                            <Grid Style="{StaticResource RowGrid}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE790;" Foreground="{StaticResource Text2}"/>
                                    <TextBlock Text="Цвет" Style="{StaticResource Label}" Margin="12,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Ellipse Width="12" Height="12" Fill="{Binding PreviewBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource Value}" Text="{Binding ColorHex}" Margin="8,0,0,0"
                                               FontFamily="Cascadia Mono, Consolas" FontWeight="Normal" FontSize="12.5"/>
                                </StackPanel>
                            </Grid>
                            <Slider Style="{StaticResource GradientSlider}" Background="{StaticResource HueTrack}"
                                    Minimum="0" Maximum="359" SmallChange="1" LargeChange="15" Value="{Binding BgHue}"/>
                            <Slider Style="{StaticResource GradientSlider}" Minimum="0" Maximum="100" Margin="0,2,0,0"
                                    SmallChange="1" LargeChange="10" Value="{Binding BgSat}" ToolTip="Насыщенность">
                                <Slider.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="White" Offset="0"/>
                                        <GradientStop Color="{Binding HueColor}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Slider.Background>
                            </Slider>

                            <Border Height="1" Background="#10FFFFFF" Margin="0,10,0,2"/>
                            <Button Style="{StaticResource RowLink}" Content="Эффекты" v:Ui.Glyph="&#xE734;"
                                    v:Ui.Value="{Binding ActiveEffectName}" Command="{Binding NavigateCommand}" CommandParameter="Effects"/>
                            <Border Height="1" Background="#10FFFFFF"/>
                            <Button Style="{StaticResource RowLink}" Content="Экран" v:Ui.Glyph="&#xE7F4;"
                                    v:Ui.Value="{Binding SyncStateText}" Command="{Binding NavigateCommand}" CommandParameter="Sync"/>
                            <Border Height="1" Background="#10FFFFFF" Margin="0,0,0,12"/>

                            <ItemsControl ItemsSource="{Binding Swatches}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Cursor="Hand" Focusable="False" ToolTip="{Binding Name}" Margin="0,0,6,0"
                                                Command="{Binding DataContext.PickSwatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Width="34" Height="34" Background="Transparent">
                                                        <Ellipse x:Name="Glow" Fill="{Binding Brush}" Margin="5" Opacity="0">
                                                            <Ellipse.Effect>
                                                                <BlurEffect Radius="12"/>
                                                            </Ellipse.Effect>
                                                        </Ellipse>
                                                        <Ellipse x:Name="Dot" Margin="6" Fill="{Binding Brush}" RenderTransformOrigin="0.5,0.5">
                                                            <Ellipse.RenderTransform>
                                                                <ScaleTransform x:Name="DotScale"/>
                                                            </Ellipse.RenderTransform>
                                                        </Ellipse>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" To="1.18" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}"/>
                                                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" To="1.18" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}"/>
                                                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.2"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                            <Trigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25" EasingFunction="{StaticResource EaseOut}"/>
                                                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25" EasingFunction="{StaticResource EaseOut}"/>
                                                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.ExitActions>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== Режим подсветки ===== -->
                <Border Margin="24,18,24,0" Background="#B00B1219" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1"
                        CornerRadius="16" Padding="6" HorizontalAlignment="Left" MinWidth="560" v:Motion.Entrance="3"
                        Style="{StaticResource ControlsPanel}" IsEnabled="{Binding ControlsEnabled}">
                    <UniformGrid Columns="3">
                        <Button Style="{StaticResource Choice}" Margin="0,0,6,0" Padding="18,12" Command="{Binding SelectModeCommand}" CommandParameter="Color"
                                v:Ui.Selected="{Binding Mode, Converter={StaticResource Is}, ConverterParameter=Color}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEA80;" FontSize="17"/>
                                <TextBlock Text="Цвет" FontSize="14" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Choice}" Margin="0,0,6,0" Padding="18,12" Command="{Binding SelectModeCommand}" CommandParameter="Effect"
                                v:Ui.Selected="{Binding Mode, Converter={StaticResource Is}, ConverterParameter=Effect}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE734;" FontSize="17"/>
                                <TextBlock Text="Эффекты" FontSize="14" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Choice}" Padding="18,12" Command="{Binding SelectModeCommand}" CommandParameter="Screen"
                                v:Ui.Selected="{Binding Mode, Converter={StaticResource Is}, ConverterParameter=Screen}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="17"/>
                                <TextBlock Text="Экран" FontSize="14" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= Правая панель ================= -->
        <Border Grid.Column="1" Background="#80060A0F" BorderBrush="#141E29" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18,64,18,18">

                    <!-- Лампа -->
                    <Border Style="{StaticResource SideCard}" v:Motion.Entrance="1">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource Text3}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                            <Setter Property="Fill" Value="#2BD47D"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Status}" FontSize="12.5" Margin="9,0,0,0" Foreground="{StaticResource Text2}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="200" ToolTip="{Binding Status}"/>
                                    </StackPanel>

                                    <!-- Имя: просмотр или редактирование -->
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                Visibility="{Binding IsRenaming, Converter={StaticResource BoolVisInv}}">
                                        <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="250"
                                                   Text="{Binding SelectedDevice.Title, FallbackValue='Лампа не выбрана'}"/>
                                        <Button Style="{StaticResource GhostIcon}" v:Ui.Glyph="&#xE70F;" Margin="4,2,0,0"
                                                ToolTip="Переименовать лампу" Command="{Binding StartRenameCommand}"/>
                                    </StackPanel>
                                    <TextBox Style="{StaticResource Input}" Margin="0,10,0,0" Width="200" HorizontalAlignment="Left"
                                             Tag="Имя лампы" Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolVis}}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SaveRenameCommand}"/>
                                            <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding SelectedDevice.Host, FallbackValue='—'}" FontSize="13.5"
                                                   Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource GhostIcon}" v:Ui.Glyph="&#xE8C8;" Margin="4,0,0,0"
                                                ToolTip="Скопировать IP" Command="{Binding CopyIpCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Border Background="#0EFFFFFF" CornerRadius="12" Padding="14,8" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Модель" Style="{StaticResource InfoKey}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ModelName}" Style="{StaticResource InfoValue}"/>
                                    <TextBlock Grid.Row="1" Text="Прошивка" Style="{StaticResource InfoKey}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FirmwareText}" Style="{StaticResource InfoValue}"/>
                                    <TextBlock Grid.Row="2" Text="На связи" Style="{StaticResource InfoKey}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UptimeText}" Style="{StaticResource InfoValue}"/>
                                </Grid>
                            </Border>

                            <Button Style="{StaticResource RowLink}" Margin="0,10,0,-6" Content="Управление устройством" v:Ui.Glyph="&#xE7F4;"
                                    Command="{Binding NavigateCommand}" CommandParameter="Devices"/>
                        </StackPanel>
                    </Border>

                    <!-- Расписание: ближайшие события -->
                    <Border Style="{StaticResource SideCard}" v:Motion.Entrance="2">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" Foreground="{StaticResource Text2}"/>
                                    <TextBlock Text="Расписание" Style="{StaticResource H2}" Margin="10,0,0,0"/>
                                </StackPanel>
                                <Button Style="{StaticResource GhostIcon}" v:Ui.Glyph="&#xE710;" HorizontalAlignment="Right"
                                        ToolTip="Добавить правило" Command="{Binding NavigateCommand}" CommandParameter="Schedule"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Upcoming}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource Text3}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource Accent}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Action}" FontSize="13"/>
                                                <TextBlock Text="{Binding When}" FontSize="12" Foreground="{StaticResource Text2}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,2"
                                       Text="Пока пусто. Добавь правило — например, тёплый свет в 19:00 и выключение в 23:30."
                                       Visibility="{Binding HasUpcoming, Converter={StaticResource BoolVisInv}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Статус -->
                    <Border Style="{StaticResource SideCard}" v:Motion.Entrance="3">
                        <StackPanel>
                            <TextBlock Text="Статус" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Яркость" Style="{StaticResource InfoKey}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource InfoValue}">
                                    <TextBlock.Text>
                                        <Binding Path="MainBright" StringFormat="{}{0:0} %"/>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Grid.Row="1" Text="Температура" Style="{StaticResource InfoKey}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MainCtText}" Style="{StaticResource InfoValue}"/>
                                <TextBlock Grid.Row="2" Text="Подсветка" Style="{StaticResource InfoKey}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValue}">
                                    <TextBlock.Text>
                                        <Binding Path="BgBright" StringFormat="{}{0:0} %"/>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Grid.Row="3" Text="Цвет" Style="{StaticResource InfoKey}"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Ellipse Width="10" Height="10" Fill="{Binding PreviewBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ColorHex}" Style="{StaticResource InfoValue}" Margin="8,5,0,5"
                                               FontFamily="Cascadia Mono, Consolas"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Система -->
                    <Border Style="{StaticResource SideCard}" v:Motion.Entrance="4">
                        <StackPanel>
                            <TextBlock Text="Система" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Autostart}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="14" Foreground="{StaticResource Text2}"/>
                                    <TextBlock Text="Автозапуск" FontSize="13.5" Margin="10,0,0,0"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource Switch}" Margin="0,12,0,0" IsChecked="{Binding SyncEnabled}"
                                      IsEnabled="{Binding ControlsEnabled}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="14" Foreground="{StaticResource Text2}"/>
                                    <TextBlock Text="Синхронизация с экраном" FontSize="13.5" Margin="10,0,0,0"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource Switch}" Margin="0,12,0,0" IsChecked="{Binding EnergySaving}"
                                      ToolTip="Без декоративной анимации — меньше нагрузка на процессор">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEC0A;" FontSize="14" Foreground="{StaticResource Text2}"/>
                                    <TextBlock Text="Энергосбережение" FontSize="13.5" Margin="10,0,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Дополнительно -->
                    <Border Style="{StaticResource SideCard}" Padding="14,10" v:Motion.Entrance="5">
                        <StackPanel>
                            <Button Style="{StaticResource RowLink}" Content="Расписание" v:Ui.Glyph="&#xE787;"
                                    Command="{Binding NavigateCommand}" CommandParameter="Schedule"/>
                            <Button Style="{StaticResource RowLink}" Content="Журнал событий" v:Ui.Glyph="&#xE8A5;"
                                    Command="{Binding OpenLogCommand}"/>
                            <Button Style="{StaticResource RowLink}" Content="Настройки" v:Ui.Glyph="&#xE713;"
                                    Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
