<UserControl x:Class="Lumen.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Lumen.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,64,36,28" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Настройки" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Запуск, интерфейс и журнал" Style="{StaticResource Label}" Margin="0,6,0,24"/>

            <Border Style="{StaticResource Card}" v:Motion.Entrance="0">
                <StackPanel>
                    <TextBlock Text="Запуск" Style="{StaticResource H1}"/>
                    <CheckBox Style="{StaticResource Switch}" Margin="0,18,0,0" IsChecked="{Binding Autostart}">
                        <StackPanel>
                            <TextBlock Text="Запускать вместе с Windows" FontSize="14"/>
                            <TextBlock Text="Без прав администратора — через автозагрузку пользователя" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" Margin="0,16,0,0" IsChecked="{Binding StartMinimized}">
                        <StackPanel>
                            <TextBlock Text="При автозапуске сразу в трей" FontSize="14"/>
                            <TextBlock Text="Окно не открывается, Lumen работает в фоне" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" v:Motion.Entrance="1">
                <StackPanel>
                    <TextBlock Text="Интерфейс" Style="{StaticResource H1}"/>
                    <CheckBox Style="{StaticResource Switch}" Margin="0,18,0,0" IsChecked="{Binding EnergySaving}">
                        <StackPanel>
                            <TextBlock Text="Энергосбережение" FontSize="14"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                                       Text="3D-сцена не «дышит», фон не дрейфует, превью эффектов стоят. Свет лампы в интерфейсе по-прежнему виден."/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" v:Motion.Entrance="2">
                <StackPanel>
                    <TextBlock Text="Журнал событий" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,14"
                               Text="Команды лампе по TCP и UDP, её ответы и уведомления, подключения, расписание, блокировка и сон ПК. Файл: %AppData%\Lumen\lumen.log (до 1 МБ, потом lumen.old.log)."/>
                    <Button Style="{StaticResource BaseButton}" HorizontalAlignment="Left" Command="{Binding OpenLogCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="13"/>
                            <TextBlock Text="Открыть журнал" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" v:Motion.Entrance="3">
                <StackPanel>
                    <TextBlock Text="О программе" Style="{StaticResource H1}"/>
                    <TextBlock Text="{Binding Version}" FontSize="14" Margin="0,14,0,0"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="Лёгкая замена Yeelight Station для Screen Light Bar Pro и других ламп с LAN Control. Крестик скрывает окно в трей, выход — через меню иконки."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
