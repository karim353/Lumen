<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <AssemblyName>Lumen</AssemblyName>
    <RootNamespace>Lumen</RootNamespace>
    <Product>Lumen</Product>
    <Version>1.1.0</Version>
    <ApplicationIcon>Assets\lumen.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Лёгкий релиз: один exe без лишних ресурсов локализации -->
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\lumen.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumen.Core\Lumen.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lumen.App.Tests" />
  </ItemGroup>

</Project>
